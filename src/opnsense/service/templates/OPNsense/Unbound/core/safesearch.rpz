{% if not helpers.empty('OPNsense.unboundplus.general.safesearch_providers') %}
{%   set safesearch_list = OPNsense.unboundplus.general.safesearch_providers.split(',') %}
$TTL 1h
@ IN SOA localhost. root.localhost. (1 2h 1h 2w 1h)
  IN NS  localhost.

{%   if 'google' in safesearch_list %}
; Google. TLDs are fetched from https://www.google.com/supported_domains.
{%     for domain in google_domains %}
www.{{ domain }} CNAME forcesafesearch.google.com.
{%     endfor %}
{%   endif %}

{%   if 'duckduckgo' in safesearch_list %}
; DuckDuckGo
duckduckgo.com CNAME safe.duckduckgo.com.
www.duckduckgo.com CNAME safe.duckduckgo.com.
start.duckduckgo.com CNAME safe.duckduckgo.com.
html.duckduckgo.com CNAME safe.duckduckgo.com.
lite.duckduckgo.com CNAME safe.duckduckgo.com.
duck.com CNAME safe.duckduckgo.com.
www.duck.com CNAME safe.duckduckgo.com.
{%   endif %}

{%   if 'bing' in safesearch_list %}
; Bing
bing.com CNAME strict.bing.com.
www.bing.com CNAME strict.bing.com.
edgeservices.bing.com CNAME strict.bing.com.
{%   endif %}

{%   if 'youtube' in safesearch_list %}
; YouTube
www.youtube.com CNAME restrictmoderate.youtube.com.
m.youtube.com CNAME restrictmoderate.youtube.com.
youtubei.googleapis.com CNAME restrictmoderate.youtube.com.
youtube.googleapis.com CNAME restrictmoderate.youtube.com.
www.youtube-nocookie.com CNAME restrictmoderate.youtube.com.
{%   endif %}

{%   if 'pixabay' in safesearch_list %}
; Pixabay
pixabay.com CNAME safesearch.pixabay.com.
www.pixabay.com CNAME safesearch.pixabay.com.
{%   endif %}

{%   if 'ecosia' in safesearch_list %}
; Ecosia
www.ecosia.org CNAME strict-safe-search.ecosia.org.
{%   endif %}

{%   if 'brave' in safesearch_list %}
; Brave
search.brave.com CNAME forcesafe.search.brave.com.
{%   endif %}

{%   if 'startpage' in safesearch_list %}
; Startpage
startpage.com CNAME safe.startpage.com.
www.startpage.com CNAME safe.startpage.com.
{%   endif %}
{% endif %}
