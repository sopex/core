<form>
    <field>
        <id>schedule.status</id>
        <label>Status</label>
        <type>ignore</type>
        <grid_view>
            <width>80</width>
            <formatter>status</formatter>
        </grid_view>
    </field>
    <field>
        <id>schedule.name</id>
        <label>Name</label>
        <type>text</type>
        <help>The schedule name may not exceed 32 characters and may only contain alphanumeric characters, underscores, and hyphens.</help>
        <grid_view>
            <width>150</width>
        </grid_view>
    </field>
    <field>
        <id>schedule.timeranges_text</id>
        <label>Time Range(s)</label>
        <type>ignore</type>
        <grid_view>
            <width>350</width>
        </grid_view>
    </field>
    <field>
        <id>schedule.descr</id>
        <label>Description</label>
        <type>text</type>
        <help>You may enter a description here for your reference.</help>
    </field>
    <field>
        <id>schedule.timeranges</id>
        <label>Time Ranges</label>
        <style>json-data</style>
        <type>hidden</type>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
</form>
