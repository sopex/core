<acl>
    <page-firewall-settings>
        <name>Firewall: Settings</name>
        <patterns>
            <pattern>ui/firewall/settings</pattern>
            <pattern>api/firewall/settings/*</pattern>
        </patterns>
    </page-firewall-settings>
    <page-filter-api>
        <name>Firewall: Rules [new]</name>
        <patterns>
            <pattern>ui/firewall/filter/*</pattern>
            <pattern>api/firewall/filter/*</pattern>
        </patterns>
    </page-filter-api>
    <page-filter-snat-api>
        <name>Firewall: NAT: Source NAT</name>
        <patterns>
            <pattern>ui/firewall/source_nat/*</pattern>
            <pattern>api/firewall/source_nat/*</pattern>
        </patterns>
    </page-filter-snat-api>
    <page-firewall-nat-npt>
        <name>Firewall: NAT: NPTv6</name>
        <patterns>
            <pattern>ui/firewall/npt/*</pattern>
            <pattern>api/firewall/npt/*</pattern>
        </patterns>
    </page-firewall-nat-npt>
    <page-firewall-nat-1-1-edit>
        <name>Firewall: NAT: 1:1</name>
        <patterns>
            <pattern>ui/firewall/one_to_one/*</pattern>
            <pattern>api/firewall/one_to_one/*</pattern>
        </patterns>
    </page-firewall-nat-1-1-edit>
    <page-firewall-schedules>
        <name>Firewall: Schedules</name>
        <patterns>
            <pattern>ui/firewall/schedule</pattern>
            <pattern>ui/firewall/schedule/*</pattern>
            <pattern>api/firewall/schedule/*</pattern>
        </patterns>
    </page-firewall-schedules>
    <page-firewall-schedules-edit>
        <!-- kept for privileges assigned to the former firewall_schedule_edit.php page -->
        <name>Firewall: Schedules: Edit</name>
        <patterns>
            <pattern>ui/firewall/schedule</pattern>
            <pattern>ui/firewall/schedule/*</pattern>
            <pattern>api/firewall/schedule/*</pattern>
        </patterns>
    </page-firewall-schedules-edit>
</acl>
