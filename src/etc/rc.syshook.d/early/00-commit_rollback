MARKER="/conf/commit_rollback_pending.json"
SNAPSHOT="/conf/commit_rollback/snapshot.xml"
TARGET="/conf/config.xml"
NOTICE="/conf/commit_rollback_notice.json"
TMP_TARGET="/conf/config.xml.boot_tmp"
BACKUP_DIR="/conf/backup"
PYTHON_BIN="/usr/local/bin/python3"
WATCHDOG_SCRIPT="/usr/local/opnsense/scripts/system/commit_watchdog.py"

# Handle orphan marker if snapshot is missing
if [ -f "${MARKER}" -a ! -f "${SNAPSHOT}" ]; then
	logger -t config -p local5.err "commit-session: boot-time revert failed: snapshot missing; removing orphan marker."
	rm -f "${MARKER}" /var/run/commit_watchdog.pid /var/run/commit_watchdog.sock
	exit 0
fi

if [ -f "${MARKER}" -a -f "${SNAPSHOT}" ]; then
	echo ">>> Protected change session was pending at boot. Reverting configuration to snapshot..."

	# Prefer Python implementation for full XML parsing and revision history tagging
	if [ -x "${PYTHON_BIN}" -a -f "${WATCHDOG_SCRIPT}" ]; then
		${PYTHON_BIN} "${WATCHDOG_SCRIPT}" --boot-revert
		echo ">>> Configuration successfully restored to pre-session snapshot."
		exit 0
	fi

	# Fallback shell implementation
	USER=$(awk -F'"' '/"username"[[:space:]]*:/ {print $4}' "${MARKER}")
	SOURCE=$(awk -F'"' '/"source"[[:space:]]*:/ {print $4}' "${MARKER}")
	[ -z "${USER}" ] && USER="system"
	[ -z "${SOURCE}" ] && SOURCE="boot"

	# Atomically restore snapshot before any services or templates read config.xml
	cp "${SNAPSHOT}" "${TMP_TARGET}"
	chmod 640 "${TMP_TARGET}"
	mv -f "${TMP_TARGET}" "${TARGET}"

	# Record backup revision
	REVERT_TIME=$(date +%s)
	mkdir -p "${BACKUP_DIR}"
	cp "${SNAPSHOT}" "${BACKUP_DIR}/config-${REVERT_TIME}.00.xml"
	chmod 640 "${BACKUP_DIR}/config-${REVERT_TIME}.00.xml"

	# Create login notice
	cat <<EOF > "${NOTICE}"
{
  "reverted_at": ${REVERT_TIME},
  "reverted_at_iso": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "username": "${USER}",
  "source": "${SOURCE}",
  "reason": "unconfirmed_at_boot",
  "backup_id": "config-${REVERT_TIME}.00.xml"
}
EOF
	chmod 640 "${NOTICE}"

	# Clean up marker and snapshot
	rm -f "${MARKER}"
	rm -f "${SNAPSHOT}"
	rm -f /var/run/commit_watchdog.pid
	rm -f /var/run/commit_watchdog.sock

	logger -t config -p local5.notice "commit-session: boot-time revert: unconfirmed protected session by ${USER} via ${SOURCE} reverted to snapshot."
	echo ">>> Configuration successfully restored to pre-session snapshot."
fi

exit 0
